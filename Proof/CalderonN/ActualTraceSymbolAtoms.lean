module

public import Proof.CalderonN.SmoothTraceSymbolCommutators
public import Proof.CalderonN.SmoothTraceMultiplierJetBounds

import Proof.CalderonN.ActualConormalCoefficientBounds
import Mathlib.Tactic

/-! At a given base point the angular symbols are generated by the
degree operator, rotations, the single scaled conormal remainder,
and smooth scalar multipliers. -/

public section

noncomputable section
open Set Metric
set_option autoImplicit false
set_option maxHeartbeats 4200000
set_option backward.isDefEq.respectTransparency false
namespace CalderonN

open BallDirichlet
variable {dim : ℕ} [NeZero dim] [Nontrivial (Fin dim)]

inductive TraceAngularAtom (dim : ℕ) where
  | identity
  | degree
  | rotation (i j : I dim)
  | conormal
  | multiplier (m : SmoothData dim)

namespace TraceAngularAtom

@[expose] def order : TraceAngularAtom dim → ℕ
  | .identity | .multiplier _ => 0
  | .degree | .rotation _ _ | .conormal => 1

@[expose] def eval (B R : Module.End ℝ (SmoothSphereTrace dim)) :
    TraceAngularAtom dim → Module.End ℝ (SmoothSphereTrace dim)
  | .identity => 1
  | .degree => B
  | .rotation i j => smoothSphereTraceRotation i j
  | .conormal => R
  | .multiplier m => smoothSphereTraceMul m

@[expose] def HasJets (J : ℝ) : TraceAngularAtom dim → Prop
  | .multiplier m => ∀ z ∈ closedBall (0:X dim) 1,LocalSmoothJetBudget m.1 z 3 J
  | _ => True

private theorem multiplier_mul_comm (m q : SmoothData dim) :
    smoothSphereTraceMul m*smoothSphereTraceMul q = smoothSphereTraceMul q*smoothSphereTraceMul m := by
  ext u : 1
  apply Subtype.ext
  funext z
  simp only [Module.End.mul_apply,smoothSphereTraceMul_apply]
  ring

theorem pair_bound (hn : 3 ≤ dim) (B R : Module.End ℝ (SmoothSphereTrace dim))
    (J C : ℝ) (hC : 1 ≤ C)
    (hRot : ∀ i j,SmoothTraceCommutatorBounds hn B 1 C (smoothSphereTraceRotation i j))
    (hR : SmoothTraceCommutatorBounds hn B 1 C R)
    (hM : ∀ m,HasJets J (.multiplier m) → SmoothTraceCommutatorBounds hn B 0 C (smoothSphereTraceMul m))
    (hRM : ∀ m,HasJets J (.multiplier m) →
      SmoothTraceAngularBound hn 0 C (R*smoothSphereTraceMul m-smoothSphereTraceMul m*R))
    (a b : TraceAngularAtom dim) (ha : HasJets J a) (hb : HasJets J b) :
    SmoothTraceSymbolComm hn (a.order+b.order) (C*C) (a.eval B R) (b.eval B R) := by
  have hC₀ : 0 ≤ C := zero_le_one.trans hC
  have hC₂ : 0 ≤ C*C := mul_nonneg hC₀ hC₀
  have hCC : C ≤ C*C := le_mul_of_one_le_right hC₀ hC
  have hOne (S : Module.End ℝ (SmoothSphereTrace dim)) (k : ℕ) :
      SmoothTraceSymbolComm hn k (C*C) 1 S :=
    SmoothTraceSymbolComm.of_commute (by rw [one_mul,mul_one]) hC₂
  have hSelf (S : Module.End ℝ (SmoothSphereTrace dim)) (k : ℕ) :
      SmoothTraceSymbolComm hn k (C*C) S S :=
    SmoothTraceSymbolComm.of_commute rfl hC₂
  have h₁ {S T : Module.End ℝ (SmoothSphereTrace dim)}
      (h : SmoothTraceAngularBound hn 0 C (S*T-T*S)) : SmoothTraceSymbolComm hn 1 (C*C) S T :=
    ⟨fun h => by omega,fun _ => h.enlarge hCC⟩
  have h₂ {S T : Module.End ℝ (SmoothSphereTrace dim)}
      (h : SmoothTraceAngularBound hn 1 C (S*T-T*S)) : SmoothTraceSymbolComm hn 2 (C*C) S T :=
    ⟨fun h => by omega,fun _ => h.enlarge hCC⟩
  cases a with
  | identity => exact hOne _ _
  | degree =>
    cases b with
    | identity => exact (hOne B 1).symm
    | degree => exact hSelf B 2
    | rotation i j => exact h₂ (hRot i j).degree
    | conormal => exact h₂ hR.degree
    | multiplier m => exact h₁ (hM m hb).degree
  | rotation i j =>
    cases b with
    | identity => exact (hOne (smoothSphereTraceRotation i j) 1).symm
    | degree => exact (h₂ (hRot i j).degree).symm
    | rotation a b => exact h₂ ((hRot a b).rotation i j)
    | conormal => exact h₂ (hR.rotation i j)
    | multiplier m => exact h₁ ((hM m hb).rotation i j)
  | conormal =>
    cases b with
    | identity => exact (hOne R 1).symm
    | degree => exact (h₂ hR.degree).symm
    | rotation i j => exact (h₂ (hR.rotation i j)).symm
    | conormal => exact hSelf R 2
    | multiplier m => exact h₁ (hRM m hb)
  | multiplier m =>
    cases b with
    | identity => exact (hOne (smoothSphereTraceMul m) 0).symm
    | degree => exact (h₁ (hM m ha).degree).symm
    | rotation i j => exact (h₁ ((hM m ha).rotation i j)).symm
    | conormal => exact (h₁ (hRM m ha)).symm
    | multiplier q => exact SmoothTraceSymbolComm.of_commute (multiplier_mul_comm m q) hC₂

@[expose] def symbolAtoms (hn : 3 ≤ dim) (B R : Module.End ℝ (SmoothSphereTrace dim))
    (J C : ℝ) (hC : 1 ≤ C) (hB : SmoothTraceAngularBound hn 1 C B)
    (hRot : ∀ i j,SmoothTraceCommutatorBounds hn B 1 C (smoothSphereTraceRotation i j))
    (hR : SmoothTraceCommutatorBounds hn B 1 C R)
    (hM : ∀ m,HasJets J (.multiplier m) → SmoothTraceCommutatorBounds hn B 0 C (smoothSphereTraceMul m))
    (hRM : ∀ m,HasJets J (.multiplier m) →
      SmoothTraceAngularBound hn 0 C (R*smoothSphereTraceMul m-smoothSphereTraceMul m*R)) :
    SmoothTraceSymbolAtoms hn where
  atom := fun k D S => ∃ a : TraceAngularAtom dim,HasJets J a ∧ k = a.order ∧ D = C ∧ S = a.eval B R
  nonneg := by
    rintro k _ S ⟨a,ha,hk,rfl,he⟩
    exact zero_le_one.trans hC
  angular := by
    rintro _ _ _ ⟨a,ha,rfl,rfl,rfl⟩
    cases a with
    | identity => exact (smoothTraceIdentity_commutatorBounds hn B).bound.enlarge hC
    | degree => exact hB
    | rotation i j => exact (hRot i j).bound
    | conormal => exact hR.bound
    | multiplier m => exact (hM m ha).bound
  comm := by
    rintro k l D E S T ⟨a,ha,hak,haD,haS⟩ ⟨b,hb,hbl,hbE,hbT⟩
    subst k l D E S T
    exact pair_bound hn B R J C hC hRot hR hM hRM a b ha hb

theorem symbolBound (hn : 3 ≤ dim) (B R : Module.End ℝ (SmoothSphereTrace dim))
    (J C : ℝ) (hC : 1 ≤ C) (hB : SmoothTraceAngularBound hn 1 C B)
    (hRot : ∀ i j,SmoothTraceCommutatorBounds hn B 1 C (smoothSphereTraceRotation i j))
    (hR : SmoothTraceCommutatorBounds hn B 1 C R)
    (hM : ∀ m,HasJets J (.multiplier m) → SmoothTraceCommutatorBounds hn B 0 C (smoothSphereTraceMul m))
    (hRM : ∀ m,HasJets J (.multiplier m) →
      SmoothTraceAngularBound hn 0 C (R*smoothSphereTraceMul m-smoothSphereTraceMul m*R))
    (a : TraceAngularAtom dim) (ha : HasJets J a) :
    SmoothTraceSymbolBounds (symbolAtoms hn B R J C hC hB hRot hR hM hRM) a.order C (a.eval B R) :=
  .atom ⟨a,ha,rfl,rfl,rfl⟩

end TraceAngularAtom

end CalderonN
