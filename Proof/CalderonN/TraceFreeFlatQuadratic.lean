module

public import Proof.CalderonN.FlatBallPolynomials
public import Proof.CalderonN.SphereFrame

import Proof.CalderonN.MetricPair
import Mathlib.Tactic

/-! Adapted from `TraceFreeFlatQuadratic` in the checked Theorem 3.1 release. -/

public section

noncomputable section
open Set Matrix Metric
open scoped ContDiff InnerProductSpace

namespace CalderonN

variable {dim : ℕ} [NeZero dim] [Nontrivial (Fin dim)]

private theorem metricPair_axis_left_eq_mulVec (γ : (MetricField dim)) (y v : (X dim)) (i : (I dim)) :
    metricPair γ y (axis i) v = (γ y *ᵥ (fun j => v j)) i := by
  rw [metricPair_eq_dotProduct]
  simp [dotProduct,axis,PiLp.single_apply,ite_mul]

private theorem metricPair_axis_axis_eq_entry (γ : (MetricField dim)) (y : (X dim)) (i j : (I dim)) :
    metricPair γ y (axis i) (axis j) = γ y i j := by
  rw [metricPair_axis_left_eq_mulVec]
  simp [Matrix.mulVec,dotProduct,axis,PiLp.single_apply,mul_ite]

/-- The quadratic generated by two flat translation adjoints is
trace-free when contracted with the inverse reference metric. -/
theorem sum_inverse_mul_flatTraceFreeQuadratic_eq_zero
    (γ : (MetricField dim)) (y : (X dim)) (hγ : (γ y).PosDef) (e : (Frame dim))
    (he : ∀ i j, metricPair γ y (e y i) (e y j) = if i=j then 1 else 0)
    {w : (X dim)} (hw : w ∈ (standardSphere dim)) :
    let a (i : (I dim)) := frameCoordinates γ y (e y) (axis i)
    ∑ i, ∑ j, (γ y)⁻¹ i j * (flatLinear (a i) w * flatLinear (a j) w -
      flatLinear (a i) (a j)/(dim : ℝ)) = 0 := by
  let M := γ y
  let v := frameVector e y w
  let V := fun i : (I dim) => v i
  let ℓ := M *ᵥ V
  let a (i : (I dim)) := frameCoordinates γ y (e y) (axis i)
  have hmap : frameCoordinates γ y (e y) v = w :=
    frameCoordinates_frameVector γ y w (e y) he
  have hlin (i : (I dim)) : flatLinear (a i) w = ℓ i := by
    change ⟪a i,w⟫_ℝ = _
    rw [← hmap,inner_frameCoordinates γ y _ _ (e y) he,metricPair_axis_left_eq_mulVec]
  have hpair (i j : (I dim)) : flatLinear (a i) (a j) = M i j := by
    change ⟪a i,a j⟫_ℝ = _
    rw [inner_frameCoordinates γ y _ _ (e y) he,metricPair_axis_axis_eq_entry]
  have hUnit : IsUnit M.det := isUnit_iff_ne_zero.mpr hγ.det_pos.ne'
  have hInv : M⁻¹ * M = 1 := Matrix.nonsing_inv_mul M hUnit
  have hmain : ∑ i, ∑ j, M⁻¹ i j * (ℓ i * ℓ j) = 1 := by
    calc
      _ = ℓ ⬝ᵥ (M⁻¹ *ᵥ ℓ) := by
        simp only [dotProduct,Matrix.mulVec,Finset.mul_sum]
        exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by ring
      _ = ℓ ⬝ᵥ V := by
        change ℓ ⬝ᵥ (M⁻¹ *ᵥ (M *ᵥ V)) = ℓ ⬝ᵥ V
        rw [mulVec_mulVec,hInv,one_mulVec]
      _ = metricPair γ y v v := by rw [dotProduct_comm,metricPair_eq_dotProduct]
      _ = 1 := frameVector_mem_sphere γ e y he ⟨w,hw⟩
  have hdiag : ∑ i, ∑ j, M⁻¹ i j * M i j = (dim : ℝ) := by
    calc
      _ = (M⁻¹ * M).trace := by
        unfold Matrix.trace
        simp only [Matrix.diag,Matrix.mul_apply]
        exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ =>
          congrArg (M⁻¹ i j * ·) ((hγ.isHermitian.isSymm.apply i j).symm)
      _ = _ := by rw [hInv]; norm_num [Matrix.trace_one]
  change ∑ i, ∑ j, M⁻¹ i j * (flatLinear (a i) w * flatLinear (a j) w -
    flatLinear (a i) (a j)/(dim : ℝ)) = 0
  simp only [hlin,hpair,mul_sub,← mul_div_assoc,Finset.sum_sub_distrib,hmain]
  simp_rw [← Finset.sum_div]
  rw [hdiag]
  rw [div_self (Nat.cast_ne_zero.mpr (NeZero.ne dim))]
  ring

end CalderonN
